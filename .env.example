# Server-only Notion integration token (NOTION_API_KEY is also accepted).
# Use the same token already connected to My Book List; never expose it as NEXT_PUBLIC_.
NOTION_TOKEN=
NOTION_MYBOOKLIST_ID=

# Deployment origin, used by the sitemap and internal links.
NEXT_PUBLIC_URL=https://blog.jeonhongshik.com

# Blog reads use Supabase PostgreSQL; images/files use a private Storage bucket.
NEXT_PUBLIC_SUPABASE_URL=
# Optional for server reads; otherwise the server key below is used with public-only RPCs.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only sync and private media key (either name is accepted). Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Set after verifying the Notion webhook subscription. Server-only signing key.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Optional: pin the subscription UUID as an additional check.
# NOTION_WEBHOOK_SUBSCRIPTION_ID=
# Optional separate bearer token for manual retry requests (falls back to the signing key).
# CRON_SECRET=

# Administrative CLI only: npm run sync:notion -- --management
# Do not configure this management token as an application runtime credential.
# SUPABASE_ACCESS_TOKEN=

# OpenAI, session cookies, Blob and an audio server are not required for book publishing.
