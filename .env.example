# Server-only Notion integration token (NOTION_API_KEY is also accepted).
# Use the same token already connected to My Book List; never expose it as NEXT_PUBLIC_.
NOTION_TOKEN=
NOTION_MYBOOKLIST_ID=

# Deployment origin, used by the sitemap and internal links.
NEXT_PUBLIC_URL=https://blog.jeonhongshik.com

# OpenAI, session cookies, Blob and an audio server are not required for book publishing.
